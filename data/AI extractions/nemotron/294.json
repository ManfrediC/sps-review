    {
      "field_name": "diagnostic_criteria",
      "value": "The patient was diagnosed with SPS (elevated anti-GAD antibody level, 431 nmol/L; normal, ≤0. 02 nmol/L).",
      "quote": "The patient was diagnosed with SPS (elevated anti-GAD antibody level, 431 nmol/L; normal, ≤0. 02 nmol/L).",
      "confidence": "high"
    },
    {
      "field_name": "diagnostic_basis_clinical",
      "value": "used",
      "quote": "She reported intermittent fatigue, mood swings, restless sleep, heat intolerance, and excessive sweating. She had also noticed palpitations and had irregular menses. Although her appetite had increased, she had maintained a stable weight. She had some eyelid swelling and minimal discomfort. A review of systems revealed considerable muscle aches and stiffness in the back and legs, gait difficulties, frequent falls, difficulty climbing stairs, and urinary incontinence.",
      "confidence": "high"
    },
    {
      "field_name": "diagnostic_basis_antibody",
      "value": "used",
      "quote": "The patient was diagnosed with SPS (elevated anti-GAD antibody level, 431 nmol/L; normal, ≤0. 02 nmol/L).",
      "confidence": "high"
    },
    {
      "field_name": "diagnostic_basis_emg",
      "value": "used",
      "quote": "Her EMG showed continuous activation of normal motor units of the paraspinal and proximal lower extremity muscles.",
      "confidence": "high"
    },
    {
      "field_name": "diagnostic_basis_treatment_response",
      "value": "used",
      "quote": "Treatment with baclofen yielded improvement in painful spasms, and she had no further falls. Her ambulation was substantially improved.",
      "confidence": "high"
    },
    {
      "field_name": "diagnostic_basis_imaging",
      "value": "used",
      "quote": "She had an extensive evaluation, including magnetic resonance imaging of the brain, which showed normal findings, and of the spine, which disclosed moderate cervical and lumbar spondylosis without spinal cord compromise.",
      "confidence": "high"
    },
    {
      "field_name": "diagnostic_basis_exclusion_of_mimics",
      "value": "used",
      "quote": "The erythrocyte sedimentation rate (Westergren), C-reactive protein, serum protein electrophoresis, and rheumatoid factor all demonstrated normal results. She had normal chest x-ray findings and restrictive physiology, with normal diffusion lung capacity corrected for volume.",
      "confidence": "high"
    },
